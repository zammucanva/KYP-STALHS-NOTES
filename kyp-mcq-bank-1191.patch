+def jaccard(a, b):
+    A, B = tok(a), tok(b)
+    if not A or not B: return 0.0
+    return len(A & B) / len(A | B)
+
+def ratio(a, b):
+    return difflib.SequenceMatcher(None, norm(a), norm(b)).ratio()
